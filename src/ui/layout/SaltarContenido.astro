---
// ENLACE "SALTAR AL CONTENIDO" (accesibilidad).
// Invisible hasta que alguien navega con la tecla Tab; lleva directo al <main id="contenido">.

interface Props {
  texto: string;
}

const { texto } = Astro.props;
---

<a class="saltar" href="#contenido">{texto}</a>

<style>
  .saltar {
    position: fixed;
    left: 16px;
    top: 16px;
    z-index: 100;
    padding: 12px 20px;
    border-radius: var(--radio-pildora);
    background: var(--verde-lima);
    color: var(--azul-petroleo);
    font-family: var(--fuente-titulos);
    font-weight: var(--peso-bold);
    font-size: 16px;
    text-decoration: none;
    transform: translateY(-200%);
  }

  .saltar:focus {
    transform: translateY(0);
  }
</style>
