---
// HEADER — franja superior + barra fija con logo, buscador, menú y botón Cotizar.
// Escritorio (1100 px o más): todo en una fila de 84 px, como en Main / D-Catalogo.
// Móvil y tableta: fila de 64 px (logo, Cotizar, hamburguesa) + buscador debajo, como en M-Inicio.
// El buscador aparece en todas las páginas (decisión del PLAN).
import Logo from '@ui/compartido/Logo';
import Icono from '@ui/compartido/Icono';
import Buscador from './Buscador.astro';
import MenuMovil from './MenuMovil';
import type { ContenidoComun } from '@dominio/paginas/comun';

interface Props {
  comun: ContenidoComun;
  paginaActual: string; // p. ej. "/catalogo", para marcar el enlace activo
}

const { comun, paginaActual } = Astro.props;
const { barraSuperior, header, logo, menuMovil, buscador, urls } = comun;
---

<div class="barra-superior">
  <div class="contenedor barra-superior__fila">
    <span>{barraSuperior.texto}</span>
    <span class="barra-superior__enlaces">
      <a href={barraSuperior.telefono.url} class="barra-superior__telefono">{barraSuperior.telefono.texto}</a>
      <a href={barraSuperior.pagos.url} class="barra-superior__pagos">{barraSuperior.pagos.texto}</a>
    </span>
  </div>
</div>

<header class="header">
  <div class="contenedor header__fila">
    <a href={urls.inicio} aria-label={logo.etiquetaEnlace} class="header__logo">
      <Logo variante="claro" />
    </a>

    <div class="header__buscador">
      <Buscador buscador={buscador} />
    </div>

    <nav aria-label={header.etiquetaMenu} class="header__nav">
      {
        header.menu.map((enlace) => (
          <a
            class="header__enlace"
            href={enlace.url}
            aria-current={enlace.url === paginaActual && enlace.url !== urls.proximamente ? 'page' : undefined}
            {...(enlace.url.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}
          >
            {enlace.texto}
          </a>
        ))
      }
    </nav>

    <div class="header__acciones">
      <a href={header.botonCotizar.url} class="btn btn--lima header__cotizar" target="_blank" rel="noopener">
        <Icono nombre="mas" tamano={14} color="#00475D" className="header__cotizar-icono" />
        {header.botonCotizar.texto}
      </a>
      <div class="header__menu-movil">
        <MenuMovil
          client:media="(max-width: 1099px)"
          textos={menuMovil}
          logo={{ etiquetaEnlace: logo.etiquetaEnlace, url: urls.inicio }}
          paginaActual={paginaActual}
        />
      </div>
    </div>
  </div>
</header>

<style>
  /* ---------- Franja superior ---------- */
  .barra-superior {
    background: var(--azul-profundo);
    color: var(--azul-claro-texto);
    font-size: 13px;
    line-height: 1.5;
  }

  .barra-superior__fila {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    padding-top: 10px;
    padding-bottom: 10px;
  }

  .barra-superior__enlaces {
    display: flex;
    gap: 20px;
  }

  .barra-superior a {
    text-decoration: none;
  }

  .barra-superior__telefono {
    color: var(--blanco);
  }

  .barra-superior__pagos {
    color: var(--verde-lima);
  }

  /* ---------- Barra fija ---------- */
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(255, 255, 255, 0.96);
    border-bottom: 1px solid var(--gris-linea);
  }

  .header__fila {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 84px;
  }

  .header__logo {
    display: flex;
    flex: none;
  }

  .header__logo :global(svg) {
    width: 124px;
    height: 36px;
  }

  .header__buscador {
    flex: 1 1 220px;
    min-width: 200px;
    max-width: 420px;
  }

  .header__nav {
    display: flex;
    gap: 22px;
    flex: none;
  }

  .header__enlace {
    font-family: var(--fuente-titulos);
    font-weight: var(--peso-semibold);
    font-size: 15px;
    color: var(--azul-petroleo);
    text-decoration: none;
    padding: 8px 0;
    border-bottom: 3px solid transparent;
  }

  .header__enlace:hover {
    border-bottom-color: var(--verde-lima);
    color: var(--azul-petroleo);
  }

  .header__enlace[aria-current='page'] {
    border-bottom-color: var(--verde-lima);
    font-weight: var(--peso-bold);
  }

  .header__acciones {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: none;
  }

  .header .header__cotizar {
    padding: 13px 22px;
  }

  .header__menu-movil {
    display: none;
  }

  /* ---------- Móvil y tableta ---------- */
  @media (max-width: 1099px) {
    .barra-superior {
      display: none;
    }

    .header {
      background: var(--blanco);
    }

    .header__fila {
      height: auto;
      flex-wrap: wrap;
      gap: 0 10px;
      padding-inline: 16px;
    }

    .header__logo {
      height: 64px;
      align-items: center;
    }

    .header__logo :global(svg) {
      width: 80px;
      height: 23px;
    }

    .header__nav {
      display: none;
    }

    .header__acciones {
      gap: 8px;
    }

    .header .header__cotizar {
      padding: 9px 14px;
      min-height: 40px;
      font-size: 14px;
      gap: 10px;
    }

    .header .header__cotizar :global(.header__cotizar-icono) {
      width: 12px;
      height: 12px;
    }

    .header__menu-movil {
      display: block;
    }

    /* El buscador baja a su propia fila */
    .header__buscador {
      order: 3;
      flex: 1 1 100%;
      max-width: none;
      min-width: 0;
      padding: 8px 0 12px;
    }
  }
</style>
