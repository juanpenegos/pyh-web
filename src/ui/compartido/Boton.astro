---
// BOTÓN (en realidad un enlace con forma de botón).
// Uso: <Boton enlace={comun.cierre.boton} variante="lima" icono="mas" />
// Variantes del diseño (Sistema): lima (acción principal), azul, linea, linea-blanca (sobre fondo oscuro).
import Icono from './Icono';
import type { Enlace } from '@dominio/comunes';

interface Props {
  enlace: Enlace;
  variante?: 'lima' | 'azul' | 'linea' | 'linea-blanca';
  icono?: 'mas';
  class?: string;
}

const { enlace, variante = 'lima', icono, class: claseExtra } = Astro.props;

// Los enlaces a otros sitios (WhatsApp) se abren en una pestaña nueva
const externo = enlace.url.startsWith('http');
---

<a
  href={enlace.url}
  class:list={['btn', `btn--${variante}`, claseExtra]}
  {...(externo ? { target: '_blank', rel: 'noopener' } : {})}
>
  {icono === 'mas' && <Icono nombre="mas" tamano={14} color="#00475D" />}
  {enlace.texto}
</a>
