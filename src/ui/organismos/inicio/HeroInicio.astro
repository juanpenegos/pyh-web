---
// HERO DE INICIO: videos que se turnan con un fundido, título, dos botones y accesos a las familias.
// Escritorio: video a todo el ancho (720 px de alto) con el texto encima.
// Móvil: video en una caja con esquina cortada y el texto debajo.
import Titular from '@ui/atomos/Titular';
import Icono from '@ui/atomos/Icono';
import VideoAuto from '@ui/atomos/VideoAuto.astro';
import type { ContenidoInicio } from '@dominio/paginas/inicio';
import BotonBase from '@ui/atomos/Boton.tsx';

interface Props {
  hero: ContenidoInicio['hero'];
}

const { hero } = Astro.props;
// Cada video se ve 8 s; el fundido está preparado para 2 o 3 videos
const cantidad = Math.min(Math.max(hero.videos.length, 2), 3);
const accesos = [...hero.accesosFamilias, hero.accesoTodo];
---

<section class:list={['hero', `hero--${cantidad}`]}>
  <div class="hero__videos" aria-hidden="true">
    {hero.videos.map((video) => (
      <div class="hero__capa">
        <VideoAuto video={video} inmediato class="hero__video" />
      </div>
    ))}
    <div class="hero__barras">
      {hero.videos.map(() => <i />)}
    </div>
  </div>

  <div class="hero__texto">
    <Titular titular={hero.titular} etiqueta="h1" className="hero__titulo" />
    <div class="hero__botones">
      <BotonBase href={hero.botonPrincipal.url} className="hero__boton hero__boton--principal">
        {hero.botonPrincipal.texto}
        <Icono nombre="diagonal" tamano={20} grosor={2.5} />
      </BotonBase>
      <BotonBase href={hero.botonSecundario.url} className="hero__boton hero__boton--secundario">
        {hero.botonSecundario.texto}
        <Icono nombre="flecha" tamano={20} />
      </BotonBase>
    </div>
  </div>

  <ul class="hero__accesos" aria-label={hero.etiquetaAccesos}>
    {accesos.map((acceso, i) => (
      <li>
        <a href={acceso.url} class:list={['hero__acceso', { 'hero__acceso--todo': i === accesos.length - 1 }]}>
          {acceso.texto}
          <Icono nombre="flecha" tamano={16} grosor={2.5} color="#89E462" />
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  /* ---------- Escritorio ---------- */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    height: 720px;
    background: var(--azul-noche);
    color: var(--blanco);
  }

  .hero__videos {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }

  .hero__capa {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  .hero__capa :global(.hero__video) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Barras de avance de cada video */
  .hero__barras {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 18px;
    z-index: 3;
    display: flex;
    justify-content: flex-end;
    gap: 8px;
    padding: 0 36px;
  }

  .hero__barras i {
    position: relative;
    display: block;
    width: 56px;
    height: 3px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.22);
    overflow: hidden;
  }

  .hero__barras i::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--verde-lima);
    transform-origin: 0 50%;
    transform: scaleX(0);
  }

  /* Fundido entre videos: 8 s cada uno */
  .hero--2 .hero__capa { animation: hero-fundido-2 16s infinite; }
  .hero--2 .hero__barras i::after { animation: hero-barra-2 16s linear infinite; }
  .hero--3 .hero__capa { animation: hero-fundido-3 24s infinite; }
  .hero--3 .hero__barras i::after { animation: hero-barra-3 24s linear infinite; }
  .hero .hero__capa:nth-child(2),
  .hero .hero__barras i:nth-child(2)::after { animation-delay: 8s; }
  .hero .hero__capa:nth-child(3),
  .hero .hero__barras i:nth-child(3)::after { animation-delay: 16s; }

  @keyframes hero-fundido-2 {
    0% { opacity: 0; }
    3% { opacity: 1; }
    50% { opacity: 1; }
    53.75% { opacity: 0; }
    100% { opacity: 0; }
  }
  @keyframes hero-barra-2 {
    0% { transform: scaleX(0); }
    50% { transform: scaleX(1); }
    50.1%, 100% { transform: scaleX(0); }
  }
  @keyframes hero-fundido-3 {
    0% { opacity: 0; }
    2% { opacity: 1; }
    33% { opacity: 1; }
    35.5% { opacity: 0; }
    100% { opacity: 0; }
  }
  @keyframes hero-barra-3 {
    0% { transform: scaleX(0); }
    33.3% { transform: scaleX(1); }
    33.4%, 100% { transform: scaleX(0); }
  }

  .hero__texto {
    position: absolute;
    left: 94px;
    bottom: 169px;
    z-index: 2;
    max-width: 560px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.6);
    animation: sube var(--dur-sube) var(--curva-sube) both;
  }

  .hero :global(.hero__titulo) {
    font-family: var(--fuente-titulos);
    font-weight: var(--peso-extrabold);
    font-size: clamp(30px, 3.2vw, 46px);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--blanco);
  }

  .hero__botones {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* Botones "de vidrio" del hero */
  .hero__boton {
    text-shadow: none;
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    backdrop-filter: blur(14px) saturate(1.3);
    transition: transform 0.25s, background 0.25s, box-shadow 0.25s, border-color 0.25s;
  }

  .hero__boton--principal {
    background: rgba(137, 228, 98, 0.82);
    border-color: rgba(255, 255, 255, 0.45);
    color: var(--azul-petroleo);
    box-shadow: 0 10px 30px rgba(137, 228, 98, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.5);
  }

  .hero__boton--principal:hover {
    background: var(--verde-lima);
    color: var(--azul-petroleo);
    box-shadow: 0 14px 38px rgba(137, 228, 98, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.6);
  }

  .hero__boton--secundario {
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.5);
    color: var(--blanco);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.18), inset 0 1px 0 rgba(255, 255, 255, 0.35);
  }

  .hero__boton--secundario:hover {
    background: rgba(255, 255, 255, 0.28);
    border-color: var(--blanco);
    color: var(--blanco);
  }

  .hero__accesos {
    position: absolute;
    left: 88px;
    right: 88px;
    bottom: 45px;
    z-index: 2;
    max-width: 1216px;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 12px;
  }

  .hero__acceso {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    min-height: 64px;
    padding: 10px 16px;
    border: 1.5px solid rgba(255, 255, 255, 0.35);
    border-radius: 14px;
    color: var(--blanco);
    text-decoration: none;
    font-family: var(--fuente-titulos);
    font-weight: var(--peso-bold);
    font-size: 16px;
    line-height: 1.1;
  }

  .hero__acceso:hover {
    color: var(--blanco);
    border-color: var(--blanco);
  }

  .hero__acceso--todo,
  .hero__acceso--todo:hover {
    border-color: var(--verde-lima);
    color: var(--verde-lima);
  }

  .hero__acceso :global(svg) {
    flex: none;
  }

  /* ---------- Tableta (hasta 1099 px) ---------- */
  @media (max-width: 1099px) {
    .hero {
      height: 560px;
    }

    .hero__texto {
      left: 32px;
      bottom: 245px;
    }

    .hero__accesos {
      left: 32px;
      right: 32px;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* ---------- Móvil ---------- */
  @media (max-width: 767px) {
    .hero {
      height: auto;
      padding: 16px 20px 44px;
    }

    /* El video va en una caja con esquina cortada */
    .hero__videos {
      position: relative;
      inset: auto;
      z-index: 0;
      margin: 0 -4px;
      aspect-ratio: 16 / 9;
      border-radius: var(--radio-lg);
      clip-path: var(--corte-sm);
    }

    .hero__barras {
      justify-content: flex-start;
      bottom: 20px;
      padding: 0 14px;
    }

    .hero__texto {
      position: relative;
      left: auto;
      bottom: auto;
      max-width: none;
      margin-top: 18px;
      gap: 0;
      text-shadow: 0 2px 14px rgba(0, 0, 0, 0.55);
    }

    .hero :global(.hero__titulo) {
      font-size: 34px;
    }

    .hero__botones {
      flex-wrap: nowrap;
      gap: 10px;
      margin-top: 20px;
    }

    .hero__boton {
      flex: 1;
      justify-content: center;
    }

    .hero__boton :global(svg) {
      width: 18px;
      height: 18px;
    }

    .hero__accesos {
      position: relative;
      left: auto;
      right: auto;
      bottom: auto;
      margin-top: 18px;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }

    .hero__acceso {
      height: 58px;
      min-height: 0;
      padding: 8px 14px;
      font-size: 15px;
      background: rgba(255, 255, 255, 0.04);
    }
  }

</style>
