---
// HEADER — franja superior + barra fija con logo, buscador, menú y botón Cotizar.
// Escritorio (1100 px o más): todo en una fila de 84 px, como en Main / D-Catalogo.
// Móvil y tableta: fila de 64 px (logo, Cotizar, hamburguesa) + buscador debajo, como en M-Inicio.
// El buscador aparece en todas las páginas (decisión del PLAN).
import Logo from '@ui/atomos/Logo';
import Icono from '@ui/atomos/Icono';
import Buscador from '@ui/moleculas/Buscador.astro';
import MenuMovil from './MenuMovil';
import type { ContenidoComun } from '@dominio/paginas/comun';
import { atributosEnlace } from '@ui/utilidades/enlaces';
import BotonBase from '@ui/atomos/Boton.tsx';

interface Props {
  comun: ContenidoComun;
  paginaActual: string; // p. ej. "/catalogo", para marcar el enlace activo
}

const { comun, paginaActual } = Astro.props;
const { barraSuperior, header, logo, menuMovil, buscador, urls } = comun;
---

<div class="barra-superior">
  <div class="contenedor barra-superior__fila">
    <span>{barraSuperior.texto}</span>
    <span class="barra-superior__enlaces">
      <a href={barraSuperior.telefono.url} class="barra-superior__telefono">{barraSuperior.telefono.texto}</a>
      <a href={barraSuperior.pagos.url} class="barra-superior__pagos">{barraSuperior.pagos.texto}</a>
    </span>
  </div>
</div>

<header class="header">
  <div class="contenedor header__fila">
    <a href={urls.inicio} aria-label={logo.etiquetaEnlace} class="header__logo">
      <Logo variante="claro" />
    </a>

    <div class="header__buscador">
      <Buscador buscador={buscador} />
    </div>

    <nav aria-label={header.etiquetaMenu} class="header__nav">
      {
        header.menu.map((enlace) => (
          <a
            class="header__enlace"
            href={enlace.url}
            aria-current={enlace.url === paginaActual && enlace.url !== urls.proximamente ? 'page' : undefined}
            {...atributosEnlace(enlace.url)}
          >
            {enlace.texto}
          </a>
        ))
      }
      <!-- Desplegable "Más": se abre al pasar el mouse, con el teclado o al tocarlo -->
      <div class="header__mas" data-header-mas>
        <button type="button" class="header__enlace header__mas-boton" aria-expanded="false" aria-controls="header-mas-lista">
          {header.mas.texto}
          <Icono nombre="abajo" tamano={14} color="#00475D" className="header__mas-flecha" />
        </button>
        <ul id="header-mas-lista" class="header__mas-lista">
          {
            header.mas.enlaces.map((enlace) => (
              <li>
                <a href={enlace.url} class="header__mas-enlace" {...atributosEnlace(enlace.url)}>
                  {enlace.texto}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>

    <div class="header__acciones">
      <BotonBase href={header.botonClientes.url} variante="azul" className="header__clientes">
        <Icono nombre="persona" tamano={16} color="#FFFFFF" />
        {header.botonClientes.texto}
      </BotonBase>
      <BotonBase href={header.botonCotizar.url} variante="lima" className="header__cotizar">
        <Icono nombre="mas" tamano={14} color="#00475D" className="header__cotizar-icono" />
        {header.botonCotizar.texto}
      </BotonBase>
      <div class="header__menu-movil">
        <MenuMovil
          client:media="(max-width: 1099px)"
          textos={menuMovil}
          logo={{ etiquetaEnlace: logo.etiquetaEnlace, url: urls.inicio }}
          paginaActual={paginaActual}
        />
      </div>
    </div>
  </div>
</header>

<script>
  // 1) Header flotante: cuando la franja superior sale de la pantalla, la barra se "despega".
  //    (Solo se ve en escritorio: los estilos de .header--flotante están dentro de min-width: 1100px.)
  const header = document.querySelector<HTMLElement>('.header');
  const franja = document.querySelector('.barra-superior');
  if (header && franja) {
    new IntersectionObserver(([entrada]) => {
      header.classList.toggle('header--flotante', !entrada.isIntersecting);
    }).observe(franja);
  }

  // 2) Desplegable "Más": se abre con el mouse o el foco (CSS); aquí solo se avisa
  //    a los lectores de pantalla si está abierto y se cierra con Escape.
  const mas = document.querySelector<HTMLElement>('[data-header-mas]');
  const boton = mas?.querySelector<HTMLButtonElement>('button');
  if (mas && boton) {
    const avisar = () => boton.setAttribute('aria-expanded', String(mas.matches(':hover, :focus-within')));
    ['mouseenter', 'mouseleave', 'focusin', 'focusout'].forEach((evento) =>
      mas.addEventListener(evento, () => requestAnimationFrame(avisar)),
    );
    mas.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        (document.activeElement as HTMLElement | null)?.blur();
        boton.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>

<style>
  /* ---------- Franja superior ---------- */
  .barra-superior {
    background: var(--azul-profundo);
    color: var(--azul-claro-texto);
    font-size: 13px;
    line-height: 1.5;
  }

  .barra-superior__fila {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    padding-top: 10px;
    padding-bottom: 10px;
  }

  .barra-superior__enlaces {
    display: flex;
    gap: 20px;
  }

  .barra-superior a {
    text-decoration: none;
  }

  .barra-superior__telefono {
    color: var(--blanco);
  }

  .barra-superior__pagos {
    color: var(--verde-lima);
  }

  /* ---------- Barra fija ---------- */
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(255, 255, 255, 0.96);
    border-bottom: 1px solid var(--gris-linea);
  }

  .header__fila {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 84px;
  }

  .header__logo {
    display: flex;
    flex: none;
  }

  .header__logo :global(svg) {
    width: 124px;
    height: 36px;
  }

  .header__buscador {
    flex: 1 1 220px;
    min-width: 200px;
    max-width: 420px;
  }

  .header__nav {
    display: flex;
    gap: 22px;
    flex: none;
  }

  .header__enlace {
    font-family: var(--fuente-titulos);
    font-weight: var(--peso-semibold);
    font-size: 15px;
    color: var(--azul-petroleo);
    text-decoration: none;
    padding: 8px 0;
    border-bottom: 3px solid transparent;
  }

  .header__enlace:hover {
    border-bottom-color: var(--verde-lima);
    color: var(--azul-petroleo);
  }

  .header__enlace[aria-current='page'] {
    border-bottom-color: var(--verde-lima);
    font-weight: var(--peso-bold);
  }

  .header__acciones {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: none;
  }

  .header .header__cotizar,
  .header .header__clientes {
    padding: 13px 22px;
  }

  .header__menu-movil {
    display: none;
  }

  /* ---------- Desplegable "Más" ---------- */
  .header__mas {
    position: relative;
    display: flex;
  }

  .header__mas-boton {
    display: flex;
    align-items: center;
    gap: 6px;
    border-top: 0;
    border-inline: 0;
    background: none;
    cursor: pointer;
  }

  .header__mas-boton :global(.header__mas-flecha) {
    transition: transform var(--dur-rapida);
  }

  .header__mas-lista {
    position: absolute;
    top: 100%;
    right: -16px;
    min-width: 180px;
    margin: 0;
    padding: 8px;
    list-style: none;
    border-radius: var(--radio-md);
    background: var(--blanco);
    box-shadow: var(--sombra-tarjeta);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition:
      opacity var(--dur-rapida),
      transform var(--dur-rapida),
      visibility var(--dur-rapida);
  }

  /* Puente invisible para que el mouse no "se caiga" entre el botón y la lista */
  .header__mas-lista::before {
    content: '';
    position: absolute;
    inset: -12px 0 auto;
    height: 12px;
  }

  .header__mas:hover .header__mas-lista,
  .header__mas:focus-within .header__mas-lista {
    opacity: 1;
    visibility: visible;
    transform: translateY(8px);
  }

  .header__mas:hover :global(.header__mas-flecha),
  .header__mas:focus-within :global(.header__mas-flecha) {
    transform: rotate(180deg);
  }

  .header__mas-enlace {
    display: block;
    padding: 10px 14px;
    border-radius: var(--radio-sm);
    font-family: var(--fuente-titulos);
    font-weight: var(--peso-semibold);
    font-size: 15px;
    color: var(--azul-petroleo);
    text-decoration: none;
  }

  .header__mas-enlace:hover,
  .header__mas-enlace:focus-visible {
    background: var(--fondo-suave);
  }

  /* ---------- Header flotante (solo escritorio) ----------
     Al bajar, la barra "se despega" del techo: baja 12 px, se redondea
     y queda con fondo blanco al 80 % y efecto vidrio. */
  @media (min-width: 1100px) {
    .header {
      transition:
        background var(--dur-media),
        border-color var(--dur-media);
    }

    .header__fila {
      border-radius: var(--radio-lg);
      transition:
        transform 0.35s var(--curva-sube),
        background 0.35s,
        box-shadow 0.35s,
        padding 0.35s;
    }

    .header--flotante {
      background: transparent;
      border-bottom-color: transparent;
    }

    .header--flotante .header__fila {
      padding-inline: 24px;
      background: rgba(255, 255, 255, 0.8);
      -webkit-backdrop-filter: blur(12px);
      backdrop-filter: blur(12px);
      box-shadow: 0 12px 32px rgba(0, 71, 93, 0.14);
      transform: translateY(12px);
    }
  }

  /* ---------- Móvil y tableta ---------- */
  @media (max-width: 1099px) {
    .barra-superior {
      display: none;
    }

    .header {
      background: var(--blanco);
    }

    .header__fila {
      height: auto;
      flex-wrap: wrap;
      gap: 0 10px;
      padding-inline: 16px;
    }

    .header__logo {
      height: 64px;
      align-items: center;
    }

    .header__logo :global(svg) {
      width: 80px;
      height: 23px;
    }

    .header__nav {
      display: none;
    }

    .header__acciones {
      gap: 8px;
    }

    /* En móvil y tableta, Clientes va dentro del menú de la hamburguesa */
    .header__clientes {
      display: none;
    }

    .header .header__cotizar {
      padding: 9px 14px;
      min-height: 40px;
      font-size: 14px;
      gap: 10px;
    }

    .header .header__cotizar :global(.header__cotizar-icono) {
      width: 12px;
      height: 12px;
    }

    .header__menu-movil {
      display: block;
    }

    /* El buscador baja a su propia fila */
    .header__buscador {
      order: 3;
      flex: 1 1 100%;
      max-width: none;
      min-width: 0;
      padding: 8px 0 12px;
    }
  }
</style>
