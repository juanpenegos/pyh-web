{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@dominio/*": ["src/dominio/*"],
      "@aplicacion/*": ["src/aplicacion/*"],
      "@infraestructura/*": ["src/infraestructura/*"],
      "@ui/*": ["src/ui/*"]
    }
  }
}
